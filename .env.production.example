# ==============================================================================
# Qwalify Production Environment Configuration (.env)
# ==============================================================================

# Domain Setup
DOMAIN=qwalify.online
WA_DOMAIN=wa.qwalify.online
ACME_EMAIL=admin@qwalify.online

# Supabase Cloud Project Settings
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Evolution API (WhatsApp) Credentials
EVOLUTION_API_KEY=generate_a_secure_random_alphanumeric_key_here
